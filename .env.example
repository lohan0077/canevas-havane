# URL publique du site (utilisée pour le SEO : metadataBase, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://canevas-havane.com

# --- Formulaire de contact (envoi via Gmail en SMTP) ---
# Prérequis : activer la validation en deux étapes sur le compte Google,
# puis générer un « mot de passe d'application » sur https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gaultlohan@gmail.com
# Mot de passe d'application (16 caractères), et non le mot de passe du compte
SMTP_PASSWORD=

# Adresse qui reçoit les messages du formulaire
CONTACT_TO_EMAIL=gaultlohan@gmail.com
